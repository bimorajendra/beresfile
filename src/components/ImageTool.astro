---
import type { Tool } from '../lib/tools';
import Icon from './Icon.astro';
import FileDrop from './FileDrop.astro';
import { COMPRESSION_PRESETS, MAX_TARGET_KB, targetLabel } from '../lib/compression-options';
interface Props { tool: Tool; home?: boolean; }
const { tool, home = false } = Astro.props;
const compressor = tool.kind === 'compress';
---
<section class="tool-panel" data-image-tool data-config={JSON.stringify(tool)} data-analytics={import.meta.env.PUBLIC_ANALYTICS_PROVIDER === 'cloudflare' ? 'cloudflare' : 'off'} aria-labelledby="tool-heading">
  <div class="panel-heading"><div class="panel-title"><Icon name={tool.icon} size={21}/><h2 id="tool-heading">{home ? 'Kompres foto' : tool.short}</h2></div><span class="local-label">Tanpa upload</span></div>
  <div class="tool-body">
    {compressor && <div class="target-control"><span class="field-label">Ukuran hasil</span><div class="segments" role="group" aria-label="Pilih ukuran hasil">
      {COMPRESSION_PRESETS.map((target) => <button type="button" data-target={target} aria-pressed={(tool.target || 0) === target}>{targetLabel(target)}</button>)}
    </div><div class="target-modes" role="group" aria-label="Pengaturan ukuran lainnya"><button type="button" data-target="-1" aria-pressed="false">Ukuran lain</button><button type="button" data-target="0" aria-pressed={!tool.target}>Atur kualitas</button></div><div class="custom-target" data-custom-wrap hidden><label for="custom-target">Target ukuran</label><div><input id="custom-target" data-custom-target type="number" inputmode="numeric" min="1" max={MAX_TARGET_KB} step="1" value={tool.target || 200} aria-describedby="custom-target-help"/><span>KB</span></div><p id="custom-target-help" class="setting-hint">Masukkan 1–25.600 KB. Hasil tidak akan melebihi target.</p><p data-target-error hidden class="field-error" role="alert"></p></div><p class="setting-hint" data-target-hint>{tool.target ? `Hasil maksimal ${targetLabel(tool.target)}. Kualitas disesuaikan otomatis.` : 'Pilih kualitas untuk menyeimbangkan detail dan ukuran foto.'}</p></div>}
    {compressor && <div data-quality-wrap hidden={Boolean(tool.target)} class="quality-control"><label for="quality">Kualitas foto <output data-quality-value>80%</output></label><input id="quality" data-quality type="range" min="10" max="95" value="80"/><div class="range-labels"><span>File lebih kecil</span><span>Detail lebih tinggi</span></div></div>}
    {(compressor || tool.kind === 'resize') && <div class="format-control"><label for="output-format">Format hasil</label><select id="output-format" data-format><option value="image/jpeg">JPG</option><option value="image/png">PNG</option><option value="image/webp">WebP</option></select><p class="setting-hint">PNG mempertahankan transparansi. Untuk batas KB yang kecil, JPG atau WebP biasanya lebih cocok.</p></div>}
    <div data-empty><FileDrop accept={tool.accept} multiple={compressor}/></div>
    <div data-editor hidden>
      <div class="selected-file"><span class="selected-icon"><Icon name="image" size={21}/></span><div><strong data-filename></strong><span data-fileinfo></span></div><button class="icon-button" data-reset type="button" aria-label="Hapus foto dan pilih ulang"><Icon name="close" size={18}/></button></div>
      <div class:list={['preview-stage', { 'crop-stage': tool.kind === 'crop' }]}><img data-preview alt="Preview foto yang dipilih"/><canvas data-crop hidden={tool.kind !== 'crop'} aria-label="Preview potongan foto; gunakan pengatur posisi di bawah untuk mengubahnya"></canvas></div>
      {tool.kind === 'crop' && <div class="crop-controls"><div class="form-grid"><div><label for="photo-size">Ukuran pas foto</label><select id="photo-size" data-photo-size><option value="236x354" selected={tool.slug.endsWith('2x3')}>2×3 · 236 × 354 px</option><option value="354x472" selected={tool.slug.endsWith('3x4')}>3×4 · 354 × 472 px</option><option value="472x708" selected={tool.slug.endsWith('4x6')}>4×6 · 472 × 708 px</option></select></div><div><label for="photo-target">Batas ukuran (KB)</label><input id="photo-target" data-photo-target type="number" min="1" max="25600" step="1" inputmode="numeric" placeholder="Opsional"/></div></div><p class="setting-hint">Kosongkan batas KB jika tidak diperlukan. Crop dan kompres berjalan sekaligus; dimensi hasil tetap sesuai pilihan.</p><p class="setting-hint">Geser foto pada preview atau atur posisi di bawah.</p><label for="zoom">Zoom <output data-zoom-value>1×</output></label><input id="zoom" data-zoom type="range" min="1" max="3" value="1" step="0.01"/><div class="position-controls"><div><label for="position-x">Posisi horizontal</label><input id="position-x" data-x type="range" min="0" max="100" value="50"/></div><div><label for="position-y">Posisi vertikal</label><input id="position-y" data-y type="range" min="0" max="100" value="50"/></div></div><p class="setting-hint" data-photo-dimensions>Hasil: {tool.width} × {tool.height} piksel · JPG</p></div>}
      {tool.kind === 'resize' && <div class="resize-controls"><label for="resize-mode">Cara resize</label><select id="resize-mode" data-resize-mode><option value="pixels">Lebar dan tinggi (piksel)</option><option value="percent">Persen dari foto asli</option></select><div class="form-grid" data-pixel-fields><div><label for="resize-width">Lebar (px)</label><input id="resize-width" data-resize-width type="number" min="1" max="16384" step="1" inputmode="numeric"/></div><div><label for="resize-height">Tinggi (px)</label><input id="resize-height" data-resize-height type="number" min="1" max="16384" step="1" inputmode="numeric"/></div></div><label class="check-control" data-lock-wrap><input type="checkbox" data-lock checked/>Kunci rasio foto asli</label><div data-percent-fields hidden><label for="resize-percent">Ukuran (%)</label><input id="resize-percent" data-resize-percent type="number" min="1" max="1000" step="1" value="50" inputmode="numeric"/></div><p class="setting-hint" data-resize-summary></p></div>}
      {tool.kind === 'convert' && tool.format === 'image/jpeg' && <div class="background-control"><label for="background">Warna latar transparan</label><input type="color" id="background" data-background value="#ffffff"/><span>Putih secara default</span></div>}
      <button type="button" class="button primary process-button" data-process><Icon name={tool.icon} size={18}/>{compressor ? 'Kompres foto' : tool.kind === 'crop' ? 'Buat pas foto' : tool.kind === 'resize' ? 'Resize foto' : `Konversi ke ${tool.format === 'image/png' ? 'PNG' : tool.format === 'image/webp' ? 'WebP' : 'JPG'}`}</button>
    </div>
    <div data-processing hidden class="processing-state" role="status" aria-live="polite"><span class="spinner" aria-hidden="true"></span><h3>Memproses foto…</h3><p>Tunggu sebentar. Waktu proses bergantung pada ukuran foto.</p></div>
    <div data-result hidden class="result-state"><div class="success-heading"><Icon name="check" size={20}/><h3>Foto siap disimpan</h3></div><div class="result-preview"><img data-result-preview alt="Preview hasil pemrosesan"/></div><div class="result-stats"><div><span>Sebelum</span><strong data-before></strong></div><Icon name="arrow" size={21}/><div><span>Sesudah</span><strong data-after></strong></div><span class="saving" data-saving></span></div><p data-result-detail class="setting-hint"></p><a class="button primary download-button" data-download><Icon name="download" size={19}/>Download foto</a><button class="button secondary" data-another type="button">Proses foto lain <Icon name="arrow" size={17}/></button></div>
    <div class="error-message" role="alert" data-error hidden></div>
    {compressor && <div data-batch hidden class="batch-panel"><h3 data-batch-heading>Foto yang dipilih</h3><p class="setting-hint">Target ukuran diterapkan ke setiap foto. File yang gagal tidak dimasukkan ke ZIP.</p><div data-batch-list class="batch-list"></div><p data-batch-status role="status" aria-live="polite"></p><progress data-batch-progress value="0" max="1" hidden aria-label="Progres kompres foto"></progress><div class="batch-actions"><button type="button" class="button primary" data-batch-process>Kompres semua foto</button><button type="button" class="button secondary" data-batch-zip hidden>Download ZIP</button><button type="button" class="button secondary" data-batch-reset>Pilih ulang</button></div></div>}
    <div class="privacy-note"><Icon name="shield" size={17}/><span>Foto diproses di browser, tidak dikirim ke server. <a href="/privasi/">Tentang privasi</a></span></div>
  </div>
</section>
<script>
  import { initImageTools } from '../lib/tool-client';
  initImageTools();
</script>
